{
  "app-id": "com.nedrichards.WhatCable.Devel",
  "desktop-file-name-suffix": " (Development)",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "whatcable-linux",
  "rename-desktop-file": "com.nedrichards.WhatCable.desktop",
  "rename-appdata-file": "com.nedrichards.WhatCable.metainfo.xml",
  "rename-icon": "com.nedrichards.WhatCable",
  "copy-icon": true,
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all"
  ],
  "modules": [
    {
      "name": "python3-pytest",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pytest==9.1.1\" --no-build-isolation"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/56/43/4ca9e49d27a1fcf6bece6f6aec0ea46bb9112489b93d4b688fb415457bdb/iniconfig-2.3.1-py3-none-any.whl",
          "sha256": "9121e2c1fdb355232495be3194c8dfe87ccc2d5dee45947b78e68f499790d7a7",
          "x-checker-data": {"type": "pypi", "name": "iniconfig", "packagetype": "bdist_wheel"}
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/54/20/4d324d65cc6d9205fabedc306948156824eb9f0ee1633355a8f7ec5c66bf/pluggy-1.6.0-py3-none-any.whl",
          "sha256": "e920276dd6813095e9377c0bc5566d94c932c33b27a3e3945d8389c374dd4746",
          "x-checker-data": {"type": "pypi", "name": "pluggy", "packagetype": "bdist_wheel"}
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/24/25/1de2678b631f5a49215c6c96fff41ba892b0a34df68d6d80292b1b48aa7f/pytest-9.1.1-py3-none-any.whl",
          "sha256": "37a86b45efb9a47a61a36449063e8e18d0cab3161329fc099eb21783169c4f0c",
          "x-checker-data": {"type": "pypi", "name": "pytest", "packagetype": "bdist_wheel"}
        }
      ]
    },
    {
      "name": "whatcable-linux",
      "buildsystem": "meson",
      "builddir": true,
      "run-tests": true,
      "config-opts": [
        "--prefix=/app",
        "-Dbuildtype=debugoptimized"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
